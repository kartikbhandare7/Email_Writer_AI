{
  "manifest_version": 3,
  "name": "Email writer Extension",
  "version": "1.0",
  "description": "AI powered email writer extension that generates email content based on user input and context.",

  "action": {
    
    "default_title": "Email Writer Assistant"
  },



  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "https://localhost:8080/*",
    "*://mail.google.com/*"
  ],


  "content_scripts": [
    {
        "js": ["content.js"],
      "matches": ["*://mail.google.com/*"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://mail.google.com/*"]
    }
  ]
}